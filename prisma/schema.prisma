generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Object {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  description String
  imageUrl    String?
  audioUrl    String?
  latitude    Float
  longitude   Float
  nfcId       String?  @unique
  qrCode      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Zone {
  id           Int     @id @default(autoincrement())
  zoneName     String
  radius       Int
  latitude     Float
  longitude    Float
  triggerAudio String?
}

model Language {
  id           Int    @id @default(autoincrement())
  languageName String
  languageCode String @unique
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}
